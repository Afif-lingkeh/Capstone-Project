APP_NAME=PEDULI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peduli
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- PEDULI ---
# Email kontak resmi untuk halaman kebijakan privasi & footer.
PEDULI_CONTACT_EMAIL=
# Nomor layanan krisis yang ditampilkan saat ada tanda bahaya (WAJIB diisi pesantren).
PEDULI_CRISIS_HOTLINE=
# Asisten AI (Claude API). Kosongkan untuk menonaktifkan fitur Asisten AI.
ANTHROPIC_API_KEY=
PEDULI_CHAT_MODEL=claude-opus-5-5
PEDULI_CHAT_EFFORT=low
PEDULI_CHAT_DAILY_LIMIT=30
# Isi true HANYA di server demo agar `php artisan db:seed --force` mengisi akun & konten contoh.
PEDULI_ALLOW_DEMO_SEED=false
# Password akun demo (default: password). Wajib diganti di server demo yang publik.
PEDULI_DEMO_PASSWORD=password
